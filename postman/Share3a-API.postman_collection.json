{
	"info": {
		"_postman_id": "share3a-api-v1",
		"name": "Share3a API",
		"description": "Share3a backend REST API (Laravel Sanctum).\n\nBase URL: `{{base_url}}/api/v1`\n\n1. Run **Auth → Login** or **Register** to save the bearer token automatically.\n2. Protected routes use the `token` collection variable.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "course_slug",
			"value": "example-course"
		},
		{
			"key": "program_slug",
			"value": "example-program"
		},
		{
			"key": "teacher_slug",
			"value": "example-teacher"
		},
		{
			"key": "announcement_slug",
			"value": "example-announcement"
		},
		{
			"key": "course_id",
			"value": "1"
		},
		{
			"key": "lesson_id",
			"value": "1"
		},
		{
			"key": "assignment_id",
			"value": "1"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
